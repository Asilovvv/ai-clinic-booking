# Copy to .env and fill in what you need. Every line is optional.

# Real AI mode: any OpenAI-compatible API. Without a key the offline assistant answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database. Locally a SQLite file is used; in the cloud set a PostgreSQL address.
DB_PATH=smile.db
# DATABASE_URL=postgresql://user:password@host/dbname

# Demo data on an empty database: 12 businesses, a demo client and a demo owner.
# Set SEED_DEMO=0 for a real launch. DEMO_PASSWORD is the password of demo@smile.kg and owner@smile.kg.
SEED_DEMO=1
SEED_HISTORY=1
DEMO_PASSWORD=demo1234

APP_TIMEZONE=Asia/Bishkek
